{
  "name": "gml-research-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "server": "node server/index.js",
    "check:meters": "node server/check.js 300",
    "test:server": "node --test server/tests/*.test.js",
    "dev": "node scripts/start.mjs",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "node scripts/start.mjs --preview",
    "test": "vitest run",
    "dev:ui": "vite",
    "stop": "node scripts/stop.mjs",
    "test:launcher": "node --test scripts/*test.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@material-symbols/svg-400": "^0.48.3",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "echarts": "6.1.0",
    "framer-motion": "^11.18.2",
    "katex": "^0.19.1",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.5",
    "three": "^0.169.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/leaflet": "1.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "7.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "4.1.12"
  }
}
